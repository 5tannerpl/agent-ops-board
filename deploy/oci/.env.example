AOB_IMAGE=ghcr.io/your-org/agent-ops-board:arm64
AOB_AUTH0_DOMAIN=your-tenant.us.auth0.com
AOB_AUTH0_AUDIENCE=https://agent-ops-board-api
AOB_EVENTS_URL=https://api.example.com/api/events
AOB_EVENT_SECRET_FILE=/opt/aob/secrets/event-secret
AOB_ALLOWED_USERS_FILE=/opt/aob/secrets/allowed_users.json
KAGGLE_CREDENTIALS_FILE=/opt/aob/secrets/kaggle.json
