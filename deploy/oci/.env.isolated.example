AOB_IMAGE=agent-ops-board:isolate-arm64
# Staging keeps Auth0, whitelist, HMAC, and OTLP security checks enabled.
AOB_ENV=staging
# OCI default. On Windows Docker Desktop set this to a local directory, for example:
# AOB_SECRETS_DIR=E:/AOB-Local-Secrets
AOB_SECRETS_DIR=/srv/aob-isolated/secrets
# These are non-production placeholders. Replace only in a local, untracked env file.
AOB_AUTH0_DOMAIN=local.invalid
AOB_AUTH0_AUDIENCE=https://local.invalid/aob
AOB_EVENTS_URL=http://event-ingress:8011/api/events
AOB_OTLP_SOURCE_TOKENS={"local-smoke":"local-smoke-token"}
