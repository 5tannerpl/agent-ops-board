# Copy to .streamlit/secrets.toml (git-ignored) and fill in the values from the Auth0 dashboard.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_LONG_RANDOM_VALUE"
expose_tokens = ["access"]

[auth.auth0]
client_id = "YOUR_AUTH0_CLIENT_ID"
client_secret = "YOUR_AUTH0_CLIENT_SECRET"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"

[auth.auth0.client_kwargs]
scope = "openid profile email aob:deployments:read aob:runs:read aob:traces:read aob:metrics:read"

[auth.auth0.authorize_params]
audience = "https://agent-ops-board-api"
